<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BlogEdit</title>
</head>
<body>
    <form action="/edit_blog_post" method="post">

        <input type="hidden" name="id" value="<%= post_edit_data.id %>">

        <label for="">Title:</label>
        <input type="text" name="title" value="<%= post_edit_data.title %>"><br><br>

        <label for="">Content:</label>
        <textarea name="content"><%= post_edit_data.content %></textarea><br><br>

        <input type="submit">
    </form>

   
</body>
</html>